# Porta do servidor (padrão 3000)
PORT=3000

# Provedor do WhatsApp: "web" (whatsapp-web.js, padrão) ou "oficial" (API oficial)
WHATSAPP_PROVIDER=web

# Números que recebem as mensagens, separados por vírgula (com DDI e DDD)
WHATSAPP_TARGET_NUMBERS=5511999999999

# Caminho do Chrome usado pelo whatsapp-web.js
CHROME_PATH=/usr/bin/google-chrome

# Somente para o provedor "oficial"
WHATSAPP_OFICIAL_URL=
WHATSAPP_OFICIAL_TOKEN=
